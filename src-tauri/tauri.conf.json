{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SangImage",
  "version": "1.6.8",
  "identifier": "com.sangyuxiaowu.sangimage",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev -- --mode tauri",
    "beforeBuildCommand": "npm run prebuild:tauri && npx vite build --mode tauri"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "SangImage",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": false
      }
    ]
  }
}
