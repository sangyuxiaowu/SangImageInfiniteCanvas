{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SangImage",
  "version": "1.5.0",
  "identifier": "com.sangyuxiaowu.sangimage",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run prebuild:tauri && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SangImage",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": false
      }
    ]
  }
}
